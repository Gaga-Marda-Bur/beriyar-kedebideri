# TEMPLATE ONLY. No real credentials. This file is never loaded automatically.
DJANGO_ENV=staging
DEBUG=False
SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ALLOWED_HOSTS=staging-api.beriyarkedebideri.com,staging.beriyarkedebideri.com
CSRF_TRUSTED_ORIGINS=https://staging.beriyarkedebideri.com
CORS_ALLOWED_ORIGINS=https://staging.beriyarkedebideri.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=False
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/REPLACE_STAGING_DATABASE
DATABASE_REQUIRE_SSL=True
# DATABASE_REQUIRE_SSL=False is accepted only with DATABASE_NETWORK=private,
# after independently verifying the provider's private network.
TRUST_X_FORWARDED_PROTO=True
NUM_PROXIES=1
# NUM_PROXIES=1 is illustrative: inspect the actual CDN/proxy chain first.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
FEEDBACK_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
FEEDBACK_CACHE_LOCATION=feedback_rate_limits
USE_R2=True
R2_ACCESS_KEY_ID=REPLACE_SERVER_KEY
R2_SECRET_ACCESS_KEY=REPLACE_SERVER_SECRET
R2_BUCKET_NAME=replace-staging-public-bucket
R2_PRIVATE_BUCKET_NAME=replace-staging-private-bucket
R2_ENDPOINT_URL=https://REPLACE_ACCOUNT.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://REPLACE_PUBLIC_MEDIA_HOST
# Or USE_R2=False with a verified persistent disk, MEDIA_STORAGE_PERSISTENT=True
# and PRIVATE_MEDIA_ROOT strictly outside public media/static roots.
BOOTSTRAP_SUPERUSER=False
