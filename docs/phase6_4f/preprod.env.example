# Beriyar Kedebideri - Preproduction Environment Template (Release Candidate 1)
# Staging / Preproduction Safe Baseline - Educational Launch

# Core Environment
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=django-preprod-change-in-secret-manager-very-long-entropy-329487239487239487!@#$
ALLOWED_HOSTS=preprod.beriyarkedebideri.org,staging.beriyarkedebideri.org,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://preprod.beriyarkedebideri.org,https://staging.beriyarkedebideri.org

# Database Configuration (PostgreSQL 17+ Strict)
DATABASE_URL=postgresql://bk_preprod_user:CHANGE_ME_PASSWORD@127.0.0.1:5432/bk_preprod_db
DATABASE_CONN_MAX_AGE=600

# Cache Configuration (Shared Redis or PostgreSQL Database Cache)
FEEDBACK_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
FEEDBACK_CACHE_LOCATION=feedback_cache_table

# Media Storage and Cloudflare R2
MEDIA_STORAGE_PERSISTENT=True
USE_R2=False
# If USE_R2 is enabled, configure isolated R2 buckets:
# R2_PUBLIC_BUCKET_NAME=bk-preprod-public-media
# R2_PRIVATE_BUCKET_NAME=bk-preprod-private-feedback
# AWS_ACCESS_KEY_ID=r2_access_key
# AWS_SECRET_ACCESS_KEY=r2_secret_key
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# SSL, HTTPS and Strict HSTS Invariants (Zero Warnings under `check --deploy`)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Educational Mode Guards
# Strict educational mode: Simulation flags disabled in release
BK_PREMIUM_SIMULATION=False
