# Enable proxy trust only after proving the edge overwrites supplied headers.
TRUST_X_FORWARDED_PROTO=False
NUM_PROXIES=0
FEEDBACK_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
FEEDBACK_CACHE_LOCATION=bk_staging_feedback_cache
