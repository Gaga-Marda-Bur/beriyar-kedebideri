# This remains false until persistence has been verified, not merely declared.
MEDIA_STORAGE_PERSISTENT=False
USE_R2=False
# PRIVATE_MEDIA_ROOT=/verified/persistent/private-directory
# No signing key provisioned for the educational staging.
MONETIZATION_SIGNING_KEY_FILE=
